{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"types": ["@types/bun"],
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["*.ts", "scripts/**/*.ts"],
	"exclude": ["node_modules", "dist", "ui"]
}
